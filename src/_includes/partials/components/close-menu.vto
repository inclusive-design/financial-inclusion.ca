<a
  class="button"
  href="/"
  onClick="document.referrer ? history.back() : window.location.href = '/'; return false;"
  aria-label="{{ __ 'Close menu', {}, {lang, translations} }}"
>
<svg
  role="presentation"
  class="close icon"
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="22"
  fill="none"
>
  <path
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-width="4"
    d="m21.375 2-19 18M2.375 2l19 18"
  ></path>
</svg>
</a>
