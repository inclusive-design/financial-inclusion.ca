<!DOCTYPE html>
<html
  lang="{{ lang }}-CA"
  dir="{{ site[lang].languages.find(item => item.code === lang).dir }}"
>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width">

    {{
      set pageTitle = title
        ? `${title} | ${site[lang ?? "en"].name}`
        : site[lang ?? "en"].name
    }}

    <title>{{ pageTitle }}</title>
    <link href="/assets/styles/main.css" rel="stylesheet" />

    {{ include "partials/global/meta.vto" }}
    <link rel="icon" href="/favicon.ico">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" id="manifest">
    <script>
      const language = "{{ lang }}";
      const manifestUrl = `/manifest-${language}.json`;

      document.querySelector("#manifest").setAttribute(
        "href",
        manifestUrl,
      );
    </script>
    <script type="module" src="/assets/scripts/main.js"></script>
    <link href="/assets/styles/main.css" rel="stylesheet" />
    <link rel="preload" as="font" type="font/woff2" crossorigin>
  </head>
  <body class='menu'>
    <header>
    	<div class="[ global ] [ inverse ]">
      		<div class="[ wrapper ] [ switcher ] [ step--1 ]">
		        <div>
		          <a rel="external" href="https://idrc.ocadu.ca/">
		            An Inclusive Design Research Centre Project
		          </a>
		        </div>
		        <ul role="list" class="[ flex ]" data-grow="false" data-separator="/">
		          <li>
		            <a href="/" lang="en-CA" hreflang="en-CA" aria-current="page"
		              >English</a
		            >
		          </li>
		          <li>
		            <a href="/fr/" lang="fr-CA" hreflang="fr-CA">Français</a>
		          </li>
		        </ul>
        	</div>
     	</div>
        {{ include "partials/global/brand.vto" }}
    </header>

    <main id="main">
        <h1 class="visually-hidden" id="site-menu">{{ title }}</h1>
        <incd-nav icon='<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 448 512"><!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path fill="currentColor" d="M201.4 406.6c12.5 12.5 32.8 12.5 45.3 0l192-192c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L224 338.7 54.6 169.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l192 192z"/></svg>'>
	       	<nav class="[ navigation ]" aria-labelledby="site-menu">
				<div class="[ wrapper ]">
                    <div class="[ menu-toggle ]">
                    {{ include "partials/components/close-menu.vto" }}
                    </div>
                    {{ include "partials/components/menu-contents.vto" }}

			</nav>
        </incd-nav>
    </main>
    {{ include "partials/global/footer.vto" }}
  </body>
</html>
